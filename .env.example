# ai-chat-logs の設定（docs/adr/0004）。
# このファイルを .env に写し、使う行のコメントを外して値を書く。
# 既にある環境変数は .env より優先される。$ と ~ は展開しないので、パスは絶対パスで書く。

# データベースのパス。既定は ${XDG_DATA_HOME:-~/.local/share}/ai-chat-logs/logs.sqlite
# AI_CHAT_LOGS_DB=/Users/you/.local/share/ai-chat-logs/logs.sqlite

# データベースの既定の場所の基準になるディレクトリ。既定は ~/.local/share
# XDG_DATA_HOME=/Users/you/.local/share

# Claude Code の設定ディレクトリ。既定は ~/.claude
# CLAUDE_CONFIG_DIR=/Users/you/.claude

# pm2 で取り込みを実行する時刻（cron の式）。既定は毎時0分
# AI_CHAT_LOGS_CRON="0 * * * *"
