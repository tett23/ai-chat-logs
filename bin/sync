#!/bin/sh
# docs/adr/0001, docs/adr/0002: list the sources, then import them.
set -eu

if ! command -v bun >/dev/null 2>&1; then
  echo "ai-chat-logs: bun is not found in PATH" >&2
  exit 127
fi

root=$(cd "$(dirname "$0")/.." && pwd)

# Collect the whole list first so that a failed listing never marks sources as missing.
sources=$(bun "$root/src/cli/sources.ts")
printf '%s\n' "$sources" | bun "$root/src/cli/import.ts" --mark-missing "$@"
